<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="stylesheet" href="/resources/css/styles.css">
</head>

<body>

    <main id="question-screen">

        <div class="game-card">

            <header id="question-header">
                <div class="logo" aria-hidden="true">&#10022;</div>
                <h1 id="game-title">Geo Game</h1>
                <h2 id="question-text">What is the capital of France?</h2>
            </header>

            <form id="options-form" action="/answer" method="POST">

                <div class="options">
                    <button type="submit" name="choice" value="Paris" class="option-btn">Country</button>
                    <button type="submit" name="choice" value="Rome" class="option-btn">Country</button>
                    <button type="submit" name="choice" value="Madrid" class="option-btn">Country</button>
                    <button type="submit" name="choice" value="Berlin" class="option-btn">Country</button>
                </div>

            </form>

            <nav id="question-links" aria-label="Game links">
                <p><a href="/">Back to Start</a></p>
            </nav>

        </div>

    </main>

</body>
</html>

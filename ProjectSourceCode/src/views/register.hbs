
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register - GEO GAME</title>
    <link rel="stylesheet" href="../resources/css/styles.css">
</head>

<body class="auth-page">

    <nav class="site-nav" aria-label="Main navigation">
        <a class="brand" href="index.html">🌍 GEO GAME</a>

        <div class="nav-links">
            <a href="index.html">Home</a>
            <a href="activeGame.html">Game</a>
            <a href="profile.html">Profile</a>
            <a href="login.html">Login</a>
            <a class="nav-signup current" href="register.html"
               aria-current="page">Sign Up</a>
        </div>
    </nav>

    <main id="register-screen" class="auth-main">

        <div class="register-card">

            <header id="register-header">
                <div class="compass" aria-hidden="true">✦</div>

                <h1 id="game-title">GEO GAME</h1>

                <span class="auth-label">New Explorer</span>

                <h2>Create an Account</h2>

                <p class="auth-subtitle">
                    Your adventure around the world starts here!
                </p>

                <div class="route-mark" aria-hidden="true">
                    <span></span>
                    <span class="dash"></span>
                    <span class="last"></span>
                </div>
            </header>

            <form id="register-form" action="/register" method="POST">

                <div class="field">
                    <label class="form-label" for="username">
                        Username
                    </label>

                    <input class="form-control"
                           type="text"
                           id="username"
                           name="username"
                           autocomplete="username"
                           minlength="3"
                           required>
                </div>

                <div class="field">
                    <label class="form-label" for="email">
                        Email
                    </label>

                    <input class="form-control"
                           type="email"
                           id="email"
                           name="email"
                           autocomplete="email"
                           required>
                </div>

                <div class="field">
                    <label class="form-label" for="password">
                        Password
                    </label>

                    <input class="form-control"
                           type="password"
                           id="password"
                           name="password"
                           autocomplete="new-password"
                           minlength="8"
                           required>
                </div>

                <div class="field">
                    <label class="form-label" for="confirm-password">
                        Confirm Password
                    </label>

                    <input class="form-control"
                           type="password"
                           id="confirm-password"
                           name="confirm-password"
                           autocomplete="new-password"
                           minlength="8"
                           required>
                </div>

                <button id="btn-register" type="submit">
                    Start Exploring!
                </button>

            </form>

            <div id="register-links">
                <p>
                    Already have an account?
                    <a href="login.html">Log in</a>
                </p>

                <p>
                    <a href="index.html">← Back to Home</a>
                </p>
            </div>

        </div>

    </main>

</body>
</html>
